#MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB=headless_cms

# --- Auth ---

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

GITHUB_ID=
GITHUB_SECRET=

# Optional. Comma-separated list of emails allowed to sign in to /admin
# (credentials or GitHub). Leave unset to skip this check and rely on the
# "admins" collection alone.
ALLOWED_ADMIN_EMAILS=

#VERCEL_OIDC_TOKEN
#BLOB_STORE_ID
BLOB_READ_WRITE_TOKEN=